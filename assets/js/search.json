---
layout: null
sitemap: false
---
[{% for p in site.pages %}{% if p.title and p.search != false and p.url != "/404.html" and p.redirect_to == nil %}{"t":{{ p.heading | default: p.title | jsonify }},"u":{{ p.url | relative_url | jsonify }},"k":{{ p.kicker_plain | default: "Page" | jsonify }},"s":{{ p.description | default: "" | jsonify }},"x":{{ p.content | strip_html | strip_newlines | truncatewords: 400, "" | jsonify }}},{% endif %}{% endfor %}{% for p in site.services %}{"t":{{ p.title | jsonify }},"u":{{ p.url | relative_url | jsonify }},"k":{{ "Service" | jsonify }},"s":{{ p.description | jsonify }},"x":{{ p.content | strip_html | strip_newlines | truncatewords: 400, "" | jsonify }}},{% endfor %}{% assign kbcur = site.kb | where_exp: "a", "a.archived != true" %}{% for p in kbcur %}{"t":{{ p.title | jsonify }},"u":{{ p.url | relative_url | jsonify }},"k":{{ p.kb_id | default: "Guide" | jsonify }},"s":{{ p.description | default: "" | jsonify }},"x":{{ p.content | strip_html | strip_newlines | truncatewords: 400, "" | jsonify }}}{% unless forloop.last %},{% endunless %}{% endfor %}]
